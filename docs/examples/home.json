                      "type": "Text",
                      "id": "article-a10-summary",
                      "props": {
                        "text": "Um resumo curto do artigo 10 sobre Material 3, para caber em duas linhas no card.",
                        "color": "onSurfaceVariant",
                        "maxLines": 2
                      }
                    },
                    {
                      "type": "Row",
                      "id": "article-a10-meta",
                      "props": {
                        "spacing": 4,
                        "padding": {
                          "start": 0,
                          "top": 8,
                          "end": 0,
                          "bottom": 0
                        }
                      },
                      "children": [
                        {
                          "type": "Icon",
                          "id": "article-a10-author-icon",
                          "props": {
                            "name": "person",
                            "tint": "onSurfaceVariant",
                            "size": 16
                          }
                        },
                        {
                          "type": "Text",
                          "id": "article-a10-author",
                          "props": {
                            "text": "Carla Dias",
                            "style": "labelMedium",
                            "color": "onSurfaceVariant"
                          }
                        }
                      ]
                    }
                  ]
                }
              ],
              "events": {
                "onClick": {
                  "type": "navigate",
                  "route": "article",
                  "params": {
                    "id": "a10"
                  }
                }
              },
              "testTag": "feed.a10",
              "analytics": {
                "name": "article_card",
                "properties": {
                  "articleId": "a10"
                }
              }
            }
          ],
          "events": {
            "onRefresh": {
              "type": "refreshScreen"
            },
            "onLoadMore": {
              "type": "request",
              "endpoint": "/api/articles",
              "query": {
                "page": {
                  "$state": "page"
                }
              }
            }
          },
          "visible": {
            "$state": "tab",
            "equals": "for-you"
          },
          "testTag": "feed"
        },
        {
          "type": "LazyColumn",
          "id": "following",
          "children": [
            {
              "type": "ListItem",
              "id": "following-0",
              "props": {
                "headline": "Ana Souza",
                "supporting": "3 artigos novos",
                "leading": {
                  "type": "Icon",
                  "id": "following-0-icon",
                  "props": {
                    "name": "account_circle",
                    "size": 40
                  }
                },
                "trailing": {
                  "type": "Icon",
                  "id": "following-0-arrow",
                  "props": {
                    "name": "keyboard_arrow_right"
                  }
                }
              },
              "events": {
                "onClick": {
                  "type": "showSnackbar",
                  "message": "Perfil de Ana Souza"
                }
              }
            },
            {
              "type": "ListItem",
              "id": "following-1",
              "props": {
                "headline": "Bruno Lima",
                "supporting": "4 artigos novos",
                "leading": {
                  "type": "Icon",
                  "id": "following-1-icon",
                  "props": {
                    "name": "account_circle",
                    "size": 40
                  }
                },
                "trailing": {
                  "type": "Icon",
                  "id": "following-1-arrow",
                  "props": {
                    "name": "keyboard_arrow_right"
                  }
                }
              },
              "events": {
                "onClick": {
                  "type": "showSnackbar",
                  "message": "Perfil de Bruno Lima"
                }
              }
            },
            {
              "type": "ListItem",
              "id": "following-2",
              "props": {
                "headline": "Carla Dias",
                "supporting": "5 artigos novos",
                "leading": {
                  "type": "Icon",
                  "id": "following-2-icon",
                  "props": {
                    "name": "account_circle",
                    "size": 40
                  }
                },
                "trailing": {
                  "type": "Icon",
                  "id": "following-2-arrow",
                  "props": {
                    "name": "keyboard_arrow_right"
                  }
                }
              },
              "events": {
                "onClick": {
                  "type": "showSnackbar",
                  "message": "Perfil de Carla Dias"
                }
              }
            }
          ],
          "visible": {
            "$state": "tab",
            "equals": "following"
          }
        }
      ]
    },
    "bottomBar": {
      "type": "NavigationBar",
      "id": "nav",
      "props": {
        "items": [
          {
            "id": "home",
            "icon": "home",
            "label": "Início",
            "route": "home",
            "testTag": "nav.home"
          },
          {
            "id": "catalog",
            "icon": "list",
            "label": "Catálogo",
            "route": "catalog",
            "testTag": "nav.catalog"
          },
          {
            "id": "settings",
            "icon": "settings",
            "label": "Ajustes",
            "route": "settings",
            "testTag": "nav.settings"
          }
        ],
        "selected": "home"
      }
    },
    "floating": {
      "type": "FAB",
      "id": "new-post",
      "props": {
        "icon": "edit",
        "label": "Escrever"
      },
      "events": {
        "onClick": {
          "type": "openSheet",
          "id": "new-post-sheet"
        }
      },
      "testTag": "home.newPost"
    },
    "modals": [
      {
        "type": "BottomSheet",
        "id": "new-post-sheet",
        "children": [
          {
            "type": "Column",
            "id": "new-post-body",
            "props": {
              "spacing": 16
            },
            "children": [
              {
                "type": "Text",
                "id": "new-post-title",
                "props": {
                  "text": "Nova publicação",
                  "style": "titleLarge"
                },
                "a11y": {
                  "heading": true
                }
              },
              {
                "type": "TextField",
                "id": "post-text",
                "props": {
                  "value": {
                    "$state": "postText"
                  },
                  "label": "O que você quer contar?",
                  "supportingText": "Até 280 caracteres",
                  "maxLength": 280,
                  "style": "outlined",
                  "singleLine": false,
                  "validation": [
                    {
                      "type": "required",
                      "message": "Escreva alguma coisa antes de publicar"
                    }
                  ]
                }
              },
              {
                "type": "Button",
                "id": "publish",
                "props": {
                  "label": "Publicar",
                  "icon": "send",
                  "fullWidth": true
                },
                "events": {
                  "onClick": {
                    "type": "validate",
                    "fields": [
                      "post-text"
                    ],
                    "onValid": {
                      "type": "request",
                      "method": "POST",
                      "endpoint": "/api/posts",
                      "body": {
                        "text": {
                          "$state": "postText"
                        }
                      },
                      "onSuccess": {
                        "type": "sequence",
                        "actions": [
                          {
                            "type": "closeSheet",
                            "id": "new-post-sheet"
                          },
                          {
                            "type": "setState",
                            "key": "postText",
                            "value": ""
                          },
                          {
                            "type": "showSnackbar",
                            "message": "Publicado!"
                          }
                        ]
                      },
                      "onError": {
                        "type": "showSnackbar",
                        "message": "Não deu certo. Tente de novo."
                      }
                    }
                  }
                },
                "testTag": "home.publish"
              },
              {
                "type": "Button",
                "id": "cancel-post",
                "props": {
                  "label": "Cancelar",
                  "style": "text",
                  "fullWidth": true
                },
                "events": {
                  "onClick": {
                    "type": "closeSheet",
                    "id": "new-post-sheet"
                  }
                }
              }
            ]
          }
        ],
        "events": {
          "onDismiss": {
            "type": "track",
            "name": "new_post_dismissed"
          }
        }
      }
    ],
    "events": {
      "onAppear": {
        "type": "track",
        "name": "home_view"
      }
    }
  }
}
